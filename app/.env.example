# ─────────────────────────────────────────────────────────────────────────────
# Queuezen environment variables
#
# You do NOT need this file for a normal installation: open your site in the
# browser and the web installer writes everything to storage/config.json.
#
# Use these variables only for Docker, Vercel, the worker, read-only hosting or
# advanced setups. Copy this file to `.env.local` (or set the variables in your
# hosting panel). Values set by the hosting panel or PM2 win over .env files.
# ─────────────────────────────────────────────────────────────────────────────

# Port the server listens on (server.js / npm start). HOST sets the address for server.js
# (default 0.0.0.0).
PORT=3000
# HOST=0.0.0.0

# Public address of the platform, used when "Site URL" is empty in Admin → Settings → General.
# OAuth redirect URIs of the social networks (/api/oauth/<platform>/callback), approval and
# short links, emails and the cron URL are built from it, so use your final https:// address.
# SITE_URL=https://social.example.com

# Where config.json, the SQLite database and uploads (logos, media on local storage) are stored.
# STORAGE_DIR=/var/lib/queuezen

# Number of reverse proxies in front of the app that add X-Forwarded-For. Used to find the
# connecting IP for rate limits (sign-in, registration, cron URL, REST API).
# Default 1: Nginx, Apache/Passenger (cPanel) or Vercel. Use 2 for Cloudflare in front of Nginx.
# TRUSTED_PROXY_HOPS=1

# Database — overrides storage/config.json when set.
# Either one connection URL (cloud providers give you this)…
# DATABASE_URL=mysql://user:password@host:3306/queuezen?ssl=true
# …or separate values:
# DB_DRIVER=mysql            # mysql or sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=queuezen
# DB_USER=queuezen
# DB_PASSWORD=secret
# DB_SSL=true                # required by TiDB Cloud, Aiven, DigitalOcean and most cloud MySQL
# DB_FILE=database.sqlite    # SQLite only, relative to STORAGE_DIR

# Create (or promote) an administrator without the web installer (password: 8+ characters).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Administrator

# Fill an empty database once with sample data for a live demo: customers, plan payments and
# messages for the admin panel, plus sample workspaces and posts for the first administrator.
# Needs ADMIN_EMAIL/ADMIN_PASSWORD. Runs once per database.
# DEMO_SEED=true

# Skip the web installer when the database is configured with the variables above
# (e.g. Vercel). Tables are created automatically; use ADMIN_* for the first administrator.
# APP_INSTALLED=true

# Keep Server Action ids stable across multiple servers / rebuilds (optional).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Demo mode for a public live demo: every social network is simulated (nothing is posted for
# real), the admin panel is read-only, registration is closed, and connecting channels, media
# uploads and settings changes are blocked in the dashboard. Must be exactly "true".
# DEMO_MODE=true

# Secret for the scheduler URL /api/cron/tick and for `npm run worker` (background jobs:
# publishing scheduled posts, token refresh, RSS feeds, analytics). Social posts go out on time
# only when something calls it every minute: a cron job, the worker or an external pinger.
# Without it, one is generated, stored in the database and shown in Admin → System → Scheduler.
# Use at least 12 random characters (e.g. `openssl rand -hex 24`); shorter values and the
# example value "change-me-to-a-long-random-string" are ignored by the app.
# Vercel Cron sends it automatically as "Authorization: Bearer <CRON_SECRET>".
# ecosystem.config.cjs and docker-compose.yml need it in their environment for the worker.
# CRON_SECRET=a-long-random-string

# Worker only (npm run worker): address of the app (default SITE_URL, else
# http://localhost:$PORT) and seconds between ticks (default 15, minimum 5).
# WORKER_URL=http://localhost:3000
# WORKER_INTERVAL_SEC=15

# App secret (at least 16 random characters, e.g. `openssl rand -hex 32`). Encrypts the access
# tokens of connected social accounts (AES-256-GCM) and signs the OAuth state of the connect
# flows. Without it, one is generated and saved in storage/config.json
# (or in the database when that file can't be written).
# SET IT on Vercel / serverless hosts and whenever several servers or containers run the app,
# so they all use the same secret. NEVER change it afterwards: tokens encrypted with the old
# secret can't be read, and customers must reconnect all their social accounts.
# APP_SECRET=a-long-random-string-of-at-least-16-characters

# ── Media storage (override Admin → Settings → Media storage) ──
# Instagram, Threads and Facebook download media from its public URL, so the storage (or your
# site, for local storage) must be reachable over public HTTPS.

# local (storage/uploads/media; needs a permanent disk, not Vercel), s3 or blob.
# STORAGE_DRIVER=s3

# S3-compatible storage: AWS S3, Cloudflare R2, MinIO, Wasabi, Backblaze B2. Used instead of the
# admin form when S3_BUCKET and S3_ACCESS_KEY_ID are set. The bucket needs a CORS rule allowing
# PUT from your site's origin with the Content-Type header, and a public URL for reading.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # empty = AWS S3 for S3_REGION
# S3_REGION=auto                                               # "auto" for R2, e.g. us-east-1 for AWS
# S3_BUCKET=queuezen-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://media.example.com                      # custom domain / r2.dev / CDN
# S3_PATH_STYLE=false                                          # true for MinIO and most self-hosted S3

# Vercel Blob read-write token (Vercel adds it when you connect a Blob store to the project).
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Private networks (single-company installations only) ──

# Allow webhook notification channels to post to private / internal addresses (localhost, 10.x,
# 192.168.x …), e.g. n8n on your own network. Never on a public platform: it would let
# customers reach your internal network.
# ALLOW_PRIVATE_WEBHOOKS=1

# Allow RSS feeds on private / local addresses (intranet feeds, automated tests). Same risk.
# ALLOW_PRIVATE_FEEDS=1

# ── Development and testing only: NEVER set these in production ──

# Build folder of Next.js (default .next). Lets a second development server run from the
# same folder, e.g. NEXT_DIST_DIR=.next-test. Don't set it in production.
# NEXT_DIST_DIR=.next

# Every social network uses the deterministic TEST driver (end-to-end tests of the engine).
# QZ_TEST_DRIVER=1

# The analytics job stores fake numbers instead of asking the networks.
# QZ_TEST_METRICS=1

# Send API requests for these prefixes to local mock servers (comma-separated from=to pairs).
# In production it would send your customers' tokens to another server.
# QUEUEZEN_TEST_API_OVERRIDES=https://api.telegram.org=http://127.0.0.1:5611/tg,https://bsky.social=http://127.0.0.1:5611/pds

# Base URL of the Anthropic API for the AI assistant (mock server in tests; default
# https://api.anthropic.com).
# AI_ANTHROPIC_BASE_URL=http://127.0.0.1:5612

# Set automatically by the platform, don't set them yourself: NODE_ENV, NEXT_PHASE (Next.js),
# VERCEL and VERCEL_PROJECT_PRODUCTION_URL (Vercel; the production domain is the last fallback
# for SITE_URL).
